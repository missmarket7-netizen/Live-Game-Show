# ── اختر مزود الذكاء الاصطناعي ──
# القيم المتاحة: gemini | openrouter | grok
AI_PROVIDER=gemini

# ── مفاتيح API (اختر حسب المزود المستخدم) ──

# 1. مفتاح Gemini من Google AI Studio
# احصل عليه من: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy...

# 2. مفتاح OpenRouter
# احصل عليه من: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# 3. مفتاح Grok من xAI
# احصل عليه من: https://console.x.ai/
GROK_API_KEY=xai-...

# ── نماذج اختيارية (اتركها كما هي للافتراضي) ──
# OPENROUTER_MODEL=openrouter/free
# GROK_MODEL=grok-2-latest
